; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="intro to game engines"
run/main_scene="uid://bse6lvobnft0r"
config/features=PackedStringArray("4.6", "Forward Plus")

[audio]

buses/default_bus_layout="uid://f30jxw4a575s"

[autoload]

OverworldMusicManager="*uid://7h4wh5f55qmf"
Scenetrancontroller="*uid://dfp7oyto4uwsy"

[display]

window/size/viewport_width=1200
window/size/viewport_height=720
window/stretch/mode="viewport"

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://assets/": "orange",
"res://scenes/": "blue",
"res://scripts/": "red"
}

[global_group]

Player="your character"
Enemys="any standard enemy"
Bosses="a boss enemy"
Pickups="any item the player can pickup"
NPC="any character not coverd by other groups"
traps="traps"

[importer_defaults]

mp3={
&"loop": true
}

